{
  "name": "whisk-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A shop on Whisk: Medusa with its storefront, in one app.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/shop.mjs build",
    "start": "node scripts/shop.mjs start",
    "dev": "node scripts/shop.mjs dev",
    "migrate": "node scripts/shop.mjs migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit && astro check --root storefront",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/caching-redis": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/file-s3": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "astro": "7.3.8",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@swc/core": "1.16.13",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@hookform/resolvers": {
      "ajv": "8.20.0"
    }
  }
}
