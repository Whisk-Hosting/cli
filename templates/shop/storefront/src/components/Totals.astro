---
import { money, sums } from "../lib/format"
type Props = { of: any }
const o = Astro.props.of
const c = o.currency_code
const m = Astro.locals.shop.market
const t = sums(o, m.taxInclusive)
---
<table class="totals">
  <tbody>
    <tr><td>Subtotal</td><td>{money(t.subtotal, c)}</td></tr>
    {t.discount > 0 && <tr><td>Discount</td><td>-{money(t.discount, c)}</td></tr>}
    <tr><td>Shipping</td><td>{(o.shipping_methods ?? []).length ? money(t.shipping, c) : "Chosen at checkout"}</td></tr>
    {!m.taxInclusive && <tr><td>{m.taxName}</td><td>{money(t.tax, c)}</td></tr>}
    <tr class="grand"><td>Total</td><td>{money(t.total, c)}</td></tr>
    {m.taxInclusive && <tr><td class="muted">Includes {m.taxName}</td><td class="muted">{money(t.tax, c)}</td></tr>}
  </tbody>
</table>
