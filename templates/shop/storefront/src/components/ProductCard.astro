---
import { fromPrice, money, picture } from "../lib/format"
type Props = { product: any }
const { product } = Astro.props
const price = fromPrice(product.variants)
const pic = picture(product.thumbnail, 400)
---
<li class="card">
  <a href={`/products/${product.handle}`}>
    <div class="pic">{pic && <img src={pic.src} srcset={pic.srcset} alt="" loading="lazy" width="400" height="400" />}</div>
    <h3>{product.title}</h3>
    {price && (
      <span class={price.sale ? "price sale" : "price"}>
        {price.varies ? "From " : ""}{money(price.amount, price.currency)}
        {price.sale && <s>{money(price.original, price.currency)}</s>}
      </span>
    )}
  </a>
</li>
