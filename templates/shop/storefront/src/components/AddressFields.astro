---
// The fields of one address. Names are prefixed so a form can hold two.
type Props = { prefix?: string; value?: any }
const { prefix = "", value = {} } = Astro.props
const v = value ?? {}
const id = (n: string) => `${prefix}${n}`
---
<div class="row two">
  <div><label for={id("first_name")}>First name</label><input id={id("first_name")} name={id("first_name")} autocomplete="given-name" required value={v.first_name ?? ""} /></div>
  <div><label for={id("last_name")}>Last name</label><input id={id("last_name")} name={id("last_name")} autocomplete="family-name" required value={v.last_name ?? ""} /></div>
</div>
<label for={id("company")}>Company <span class="muted">(optional)</span></label>
<input id={id("company")} name={id("company")} autocomplete="organization" value={v.company ?? ""} />
<label for={id("address_1")}>Address</label>
<input id={id("address_1")} name={id("address_1")} autocomplete="address-line1" required value={v.address_1 ?? ""} />
<label for={id("address_2")}>Suburb or unit <span class="muted">(optional)</span></label>
<input id={id("address_2")} name={id("address_2")} autocomplete="address-line2" value={v.address_2 ?? ""} />
<div class="row two">
  <div><label for={id("city")}>Town or city</label><input id={id("city")} name={id("city")} autocomplete="address-level2" required value={v.city ?? ""} /></div>
  <div><label for={id("postal_code")}>Postcode</label><input id={id("postal_code")} name={id("postal_code")} autocomplete="postal-code" inputmode="numeric" required value={v.postal_code ?? ""} /></div>
</div>
<input type="hidden" name={id("country_code")} value={v.country_code ?? "nz"} />
<label for={id("phone")}>Phone <span class="muted">(for the courier)</span></label>
<input id={id("phone")} name={id("phone")} type="tel" autocomplete="tel" value={v.phone ?? ""} />
