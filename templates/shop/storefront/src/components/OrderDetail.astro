---
// One order as the customer sees it: what to pay if it waits on a bank transfer, the lines,
// the totals and where it is going.
import Totals from "./Totals.astro"
import { money, picture } from "../lib/format"
type Props = { order: any }
const o = Astro.props.order
const bank = Astro.locals.shop.bank
const providers: string[] = (o.payment_collections ?? []).flatMap((c: any) => [...(c.payments ?? []), ...(c.payment_sessions ?? [])]).map((x: any) => x.provider_id)
const awaitingTransfer = providers[0] === "pp_system_default" && bank && o.payment_status !== "captured" && o.status !== "canceled"
const addr = o.shipping_address
---
{awaitingTransfer && (
  <div class="notice">
    <h2>Pay by bank transfer</h2>
    <table class="totals">
      <tbody>
        <tr><td>Amount</td><td>{money(o.total, o.currency_code)}</td></tr>
        <tr><td>Account name</td><td>{bank.accountName}</td></tr>
        <tr><td>Account number</td><td>{bank.accountNumber}</td></tr>
        <tr><td>Reference</td><td>{o.display_id}</td></tr>
      </tbody>
    </table>
  </div>
)}
<ul class="lines">
  {(o.items ?? []).map((i: any) => {
    const pic = picture(i.thumbnail, 72)
    return (
      <li class="line">
        {pic ? <img src={pic.src} srcset={pic.srcset} alt="" width="72" height="72" /> : <span />}
        <div>
          <div>{i.product_title ?? i.title}</div>
          {i.variant_title && <div class="muted">{i.variant_title}</div>}
          <div class="muted">× {i.quantity}</div>
        </div>
        <div class="price">{money(i.total, o.currency_code)}</div>
      </li>
    )
  })}
</ul>
<Totals of={o} />
{addr?.address_1 && (
  <section>
    <h2>Delivery</h2>
    <p>
      {[addr.first_name, addr.last_name].filter(Boolean).join(" ")}<br />
      {addr.company && <>{addr.company}<br /></>}
      {addr.address_1}<br />
      {addr.address_2 && <>{addr.address_2}<br /></>}
      {addr.city} {addr.postal_code}
    </p>
    {(o.shipping_methods ?? [])[0] && <p class="muted">{o.shipping_methods[0].name}</p>}
  </section>
)}
