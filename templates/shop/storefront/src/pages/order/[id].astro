---
// The page a customer lands on after placing an order.
import Shop from "../../layouts/Shop.astro"
import OrderDetail from "../../components/OrderDetail.astro"
import { api, ApiError } from "../../lib/medusa"
import { order as getOrder } from "../../lib/store"

const a = api(Astro.locals.shop, Astro.request)
const o = await getOrder(a, Astro.params.id ?? "").catch((e) => {
  if (e instanceof ApiError && e.status === 404) return null
  throw e
})
if (!o) return Astro.rewrite("/404")
---
<Shop title={`Order ${o.display_id}`} noindex>
  <h1>Thank you</h1>
  <p>Order #{o.display_id} · {o.email}</p>
  <OrderDetail order={o} />
  <p><a class="button quiet" href="/shop">Keep shopping</a></p>
</Shop>
