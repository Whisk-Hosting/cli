---
import Shop from "../../layouts/Shop.astro"
import ProductGrid from "../../components/ProductGrid.astro"
import { api } from "../../lib/medusa"
import { collectionByHandle, products } from "../../lib/store"

const shop = Astro.locals.shop
const a = api(shop, Astro.request)
const collection = await collectionByHandle(a, Astro.params.handle ?? "")
if (!collection) return Astro.rewrite("/404")
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1)
const perPage = 24
const { products: list, count } = await products(a, shop, { collection: collection.id, limit: perPage, offset: (page - 1) * perPage })
---
<Shop title={collection.title} description={`${collection.title} at ${shop.name}.`}>
  <h1>{collection.title}</h1>
  <ProductGrid products={list} count={count} page={page} perPage={perPage} base={Astro.url.pathname + Astro.url.search} />
</Shop>
