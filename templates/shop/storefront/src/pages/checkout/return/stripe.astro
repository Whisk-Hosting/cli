---
// Where Stripe sends the customer back after the payment (and any bank check). The order is
// placed if Stripe says they paid.
import { api } from "../../../lib/medusa"
import { cartIdOf } from "../../../lib/store"
import { complete } from "../../../lib/checkout"

const cartId = cartIdOf(Astro.cookies)
if (!cartId) return Astro.redirect("/account")
if (Astro.url.searchParams.get("redirect_status") === "failed") return Astro.redirect("/checkout?pay=1&error=Your%20payment%20didn%27t%20go%20through.%20Try%20again%20or%20pay%20another%20way.")
const done = await complete(api(Astro.locals.shop, Astro.request), Astro.cookies, cartId)
return "order" in done ? Astro.redirect(`/order/${done.order.id}`) : Astro.redirect(`/checkout?pay=1&error=${encodeURIComponent(done.error)}`)
---
