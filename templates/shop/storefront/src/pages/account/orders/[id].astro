---
// One of the signed-in customer's orders.
import Shop from "../../../layouts/Shop.astro"
import OrderDetail from "../../../components/OrderDetail.astro"
import { api, ApiError } from "../../../lib/medusa"
import { me, order as getOrder } from "../../../lib/store"

const a = api(Astro.locals.shop, Astro.request)
const customer = await me(a)
if (!customer) return Astro.redirect(`/account?return=${encodeURIComponent(Astro.url.pathname)}`)
const o = await getOrder(a, Astro.params.id ?? "").catch((e) => {
  if (e instanceof ApiError && e.status === 404) return null
  throw e
})
if (!o || o.customer_id !== customer.id) return Astro.rewrite("/404")
const date = new Intl.DateTimeFormat("en-NZ", { dateStyle: "medium", timeZone: "Pacific/Auckland" }).format(new Date(o.created_at))
---
<Shop title={`Order ${o.display_id}`} noindex>
  <p><a href="/account">Account</a></p>
  <h1>Order #{o.display_id}</h1>
  <p class="muted">{date}</p>
  <OrderDetail order={o} />
</Shop>
