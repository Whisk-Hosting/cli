---
// The customer's account. Signed out: sign in with an emailed code (the default), with a
// password, or open an account. Signed in: orders, saved addresses and details.
import Shop from "../../layouts/Shop.astro"
import AddressFields from "../../components/AddressFields.astro"
import { api } from "../../lib/medusa"
import { me, myOrders } from "../../lib/store"
import { money, safeReturn } from "../../lib/format"
import { MIN_PASSWORD } from "../../lib/account"

const shop = Astro.locals.shop
const a = api(shop, Astro.request)
const p = Astro.url.searchParams
const customer = await me(a)
const failed = p.get("error")
const ret = safeReturn(p.get("return"), "/account")
const step = p.get("step") ?? "email"
const email = p.get("email") ?? ""
const orders = customer ? (await myOrders(a, 20, 0)).orders : []
const addresses: any[] = customer?.addresses ?? []
const editing = p.get("address")
const editAddress = editing && editing !== "new" ? addresses.find((x) => x.id === editing) : null
const date = (s: string) => new Intl.DateTimeFormat(Astro.locals.shop.market.locale, { dateStyle: "medium", timeZone: Astro.locals.shop.market.timeZone }).format(new Date(s))
const status = (o: any) =>
  o.status === "canceled" ? "Cancelled"
  : o.fulfillment_status === "delivered" ? "Delivered"
  : ["shipped", "partially_shipped"].includes(o.fulfillment_status) ? "Sent"
  : o.payment_status === "not_paid" || o.payment_status === "awaiting" ? "Awaiting payment"
  : "Being prepared"
---
<Shop title="Account" noindex>
  {failed && <p class="notice error" role="alert">{failed}</p>}
  {customer ? (
    <div class="account">
      <div class="heading">
        <h1>{customer.first_name || customer.email}</h1>
        <form method="post" action="/account/sign-out"><button class="quiet" type="submit">Sign out</button></form>
      </div>

      <section aria-labelledby="orders">
        <h2 id="orders">Orders</h2>
        {orders.length === 0 ? (
          <p class="muted">No orders yet.</p>
        ) : (
          <ul class="lines">
            {orders.map((o) => (
              <li class="order-row">
                <a href={`/account/orders/${o.id}`}>#{o.display_id}</a>
                <span class="muted">{date(o.created_at)}</span>
                <span>{status(o)}</span>
                <span class="price">{money(o.total, o.currency_code)}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="addresses">
        <h2 id="addresses">Addresses</h2>
        <ul class="lines">
          {addresses.map((x) => (
            <li class="order-row">
              <span>{x.first_name} {x.last_name}, {x.address_1}{x.address_2 ? `, ${x.address_2}` : ""}, {x.city} {x.postal_code}</span>
              {x.is_default_shipping ? <span class="muted">Default</span> : (
                <form method="post" action="/account/addresses">
                  <input type="hidden" name="action" value="default" /><input type="hidden" name="id" value={x.id} />
                  <button class="link" type="submit">Make default</button>
                </form>
              )}
              <a href={`/account?address=${x.id}#address-form`}>Edit</a>
              <form method="post" action="/account/addresses">
                <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={x.id} />
                <button class="link" type="submit">Remove</button>
              </form>
            </li>
          ))}
        </ul>
        {editing ? (
          <form id="address-form" method="post" action="/account/addresses" class="step">
            <input type="hidden" name="action" value={editAddress ? "edit" : "add"} />
            {editAddress && <input type="hidden" name="id" value={editAddress.id} />}
            <AddressFields value={editAddress ?? {}} />
            <p />
            <button type="submit">Save address</button> <a class="button quiet" href="/account#addresses">Cancel</a>
          </form>
        ) : (
          <a class="button quiet" href="/account?address=new#address-form">Add an address</a>
        )}
      </section>

      <section aria-labelledby="details">
        <h2 id="details">Details</h2>
        <form method="post" action="/account/details">
          <div class="row two">
            <div><label for="first_name">First name</label><input id="first_name" name="first_name" autocomplete="given-name" required value={customer.first_name ?? ""} /></div>
            <div><label for="last_name">Last name</label><input id="last_name" name="last_name" autocomplete="family-name" required value={customer.last_name ?? ""} /></div>
          </div>
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" value={customer.phone ?? ""} />
          <label>Email</label>
          <p>{customer.email}</p>
          <button type="submit">Save</button> <a class="button quiet" href={`/account/password?email=${encodeURIComponent(customer.email)}`}>Set a password</a>
        </form>
      </section>
    </div>
  ) : (
    <div class="narrow">
      {step === "code" ? (
        <>
          <h1>Check your email</h1>
          <p class="muted">Code sent to {email}</p>
          <form method="post" action="/account/code/verify">
            <input type="hidden" name="email" value={email} />
            <input type="hidden" name="return" value={ret} />
            <label for="code">Code</label>
            <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" required autofocus />
            <p />
            <button class="wide" type="submit">Sign in</button>
          </form>
          <form method="post" action="/account/code">
            <input type="hidden" name="email" value={email} />
            <input type="hidden" name="return" value={ret} />
            <p><button class="link" type="submit">Send a new code</button></p>
          </form>
        </>
      ) : step === "password" ? (
        <>
          <h1>Sign in</h1>
          <form method="post" action="/account/sign-in">
            <input type="hidden" name="return" value={ret} />
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required value={email} />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
            <p />
            <button class="wide" type="submit">Sign in</button>
          </form>
          <p><a href={`/account/password?email=${encodeURIComponent(email)}`}>Forgot password</a> · <a href={`/account?return=${encodeURIComponent(ret)}`}>Email me a code instead</a></p>
        </>
      ) : step === "register" ? (
        <>
          <h1>Create an account</h1>
          <form method="post" action="/account/register">
            <input type="hidden" name="return" value={ret} />
            <div class="row two">
              <div><label for="first_name">First name</label><input id="first_name" name="first_name" autocomplete="given-name" required value={p.get("first_name") ?? ""} /></div>
              <div><label for="last_name">Last name</label><input id="last_name" name="last_name" autocomplete="family-name" required value={p.get("last_name") ?? ""} /></div>
            </div>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required value={email} />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
            <p />
            <button class="wide" type="submit">Create account</button>
          </form>
          <p><a href={`/account?return=${encodeURIComponent(ret)}`}>Sign in</a></p>
        </>
      ) : (
        <>
          <h1>Sign in</h1>
          <form method="post" action="/account/code">
            <input type="hidden" name="return" value={ret} />
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required value={email} />
            <p />
            <button class="wide" type="submit">Email me a code</button>
          </form>
          <p><a href={`/account?step=password&return=${encodeURIComponent(ret)}`}>Use a password</a> · <a href={`/account?step=register&return=${encodeURIComponent(ret)}`}>Create an account</a></p>
        </>
      )}
    </div>
  )}
</Shop>
