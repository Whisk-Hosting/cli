---
// Setting a password. Without a token: ask for the emailed link. With one (from that email):
// choose the new password.
import Shop from "../../layouts/Shop.astro"
import { MIN_PASSWORD } from "../../lib/account"

const p = Astro.url.searchParams
const token = p.get("token")
const email = p.get("email") ?? ""
const failed = p.get("error")
---
<Shop title="Password" noindex>
  <div class="narrow">
    <h1>{token ? "New password" : "Set a password"}</h1>
    {failed && <p class="notice error" role="alert">{failed}</p>}
    {p.get("sent") ? (
      <p class="notice">Check your email for the link.</p>
    ) : token ? (
      <form method="post" action="/account/password/set">
        <input type="hidden" name="token" value={token} />
        <input type="hidden" name="email" value={email} />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required autofocus />
        <p />
        <button class="wide" type="submit">Save and sign in</button>
      </form>
    ) : (
      <form method="post" action="/account/password/request">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required value={email} />
        <p />
        <button class="wide" type="submit">Email me a link</button>
      </form>
    )}
  </div>
</Shop>
