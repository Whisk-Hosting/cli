{
  "name": "whisk-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p fuzz/tsconfig.json",
    "test": "tsx --test test/*.test.ts && node fuzz/run.mjs --regression",
    "fuzz": "node fuzz/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@hono/node-server": "^2.1.1",
    "@hono/otel": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@sentry/node": "^10.73.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "inngest": "^4.20.0",
    "ioredis": "^5.9.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
