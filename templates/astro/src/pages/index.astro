---
// Public (routes.public in whisk.yaml): it greets whoever is signed in.
import { identity } from "../whisk.js";

const appName = process.env.WHISK_APP_NAME ?? "whisk-astro";
const id = identity((n) => Astro.request.headers.get(n) ?? undefined);
const greeting = id.audience === "anonymous" ? "You are not signed in." : `Signed in as ${id.name || id.email}.`;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{appName}</title></head>
  <body style="font-family:system-ui;max-width:40rem;margin:4rem auto;padding:0 1rem">
    <h1>{appName}</h1>
    <p>{greeting}</p>
    <p><a href="/notes">Notes</a> · <a href="/.whisk/login?return=/">Sign in</a> · <a href="/.whisk/logout?return=/">Sign out</a></p>
  </body>
</html>
